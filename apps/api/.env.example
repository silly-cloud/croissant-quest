# Postgres 16. Local dev role/database; never put real credentials here.
DATABASE_URL=postgresql://cq:cq@localhost:5432/cq_dev
# Optional. Without it /v1/coach/* answers {fallback:true, reason:"no_key"} and the web app plays a local round.
ANTHROPIC_API_KEY=
# Optional. Which coach to use: anthropic (default, needs ANTHROPIC_API_KEY) or claude-cli (your local Claude Code
# login and subscription, no key, this computer only: docs/LOCAL-CLAUDE-CLI.md). `pnpm dev:local` sets claude-cli.
COACH_PROVIDER=
# claude-cli only. `claude` from PATH (default) or an absolute path.
CLAUDE_CLI_PATH=
# Optional. Interface to listen on; empty = all (Docker). claude-cli allows only 127.0.0.1 or ::1 (default 127.0.0.1).
HOST=
PORT=3001
# The only browser origin allowed by CORS (credentials are enabled for it).
WEB_ORIGIN=http://localhost:3000
# Optional. 0 = no trusted reverse proxy (X-Forwarded-For ignored).
TRUST_PROXY_HOPS=0
# Optional coach/device abuse limits (ADR 0009). Empty = default
# (120/min and 500/day overall, 50/day per device, 20/min per IP, 20 new devices per IP per hour).
COACH_GLOBAL_PER_MIN=
COACH_GLOBAL_PER_DAY=
COACH_DEVICE_PER_DAY=
COACH_IP_PER_MIN=
DEVICE_CREATE_PER_IP_PER_HOUR=
# Controlled phone test only (COACH_PROVIDER=claude-cli): one extra browser origin and one client IPv4. Both or neither.
# Keep HOST=127.0.0.1; a TLS proxy on the public port forwards to the web app, and the firewall allows only that IP.
# PUBLIC_TEST_ORIGIN=https://phone-test.example   (set WEB_ORIGIN to the same value, COOKIE_SECURE=true)
# PUBLIC_TEST_CLIENT_IP=198.51.100.7
